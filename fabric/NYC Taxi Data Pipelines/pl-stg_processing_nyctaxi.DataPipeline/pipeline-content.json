            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "v_end_date",
          "value": {
            "value": "@addToTime(concat(variables('v_date'),'-01'),1,'Month')",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Setting endDate for SP",
        "dependsOn": [
          {
            "activity": "Copy trip data to Staging",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "SqlServerStoredProcedure",
