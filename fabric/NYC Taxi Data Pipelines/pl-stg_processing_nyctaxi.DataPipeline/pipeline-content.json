        "dependsOn": [
          {
            "activity": "Setting startDate for Copy Data",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "SqlServerStoredProcedure",
        "typeProperties": {
          "storedProcedureName": "[stg].[data_cleaning_stg]",
          "storedProcedureParameters": {
            "end_date": {
              "value": {
                "value": "@variables('v_end_date')",
                "type": "Expression"
              },
              "type": "DateTime"
            },
            "start_date": {
              "value": {
                "value": "@concat(variables('v_date'),'-01')",
