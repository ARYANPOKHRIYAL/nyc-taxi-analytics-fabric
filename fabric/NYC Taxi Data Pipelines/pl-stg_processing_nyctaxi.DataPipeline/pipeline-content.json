              "workspaceId": "00000000-0000-0000-0000-000000000000"
            },
            "annotations": []
          }
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "SP Loading Stg Metadata",
        "description": "Loading the staging run metadata in the processing log table",
        "dependsOn": [
          {
            "activity": "SP Remove Outliers",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "Script",
        "typeProperties": {
          "scripts": [
            {
              "text": {
                "value": "SELECT TOP 1\r\nlatest_processed_pickup\r\nFROM metadata.processing_log\r\nWHERE table_processed = 'staging_nyctaxi_yellow'\r\nORDER BY latest_processed_pickup DESC",
                "type": "Expression"
              },
              "type": "Query"
            }
          ],
          "scriptBlockExecutionTimeout": "02:00:00"
        },
        "linkedService": {
          "name": "NYCProjectWarehouse",
          "properties": {
            "type": "DataWarehouse",
            "typeProperties": {
              "artifactId": "83a7afb7-8251-98fb-44df-e825a8c2191d",
              "endpoint": "p7kycg7xgfxuba347quhwvh7vi-u7tjflwuqiqejihhbksgmto74y.datawarehouse.fabric.microsoft.com",
              "workspaceId": "00000000-0000-0000-0000-000000000000"
            },
            "annotations": []
          }
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Latest processed data",
        "description": "Fetching the latest processed pickup date from the latest processed data in the processing log table",
        "dependsOn": []
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "v_date",
          "value": {
            "value": "@formatDateTime(\n    addToTime(\n        activity('Latest processed data').output.resultSets[0].rows[0].latest_processed_pickup,\n        1, 'month' ),\n    'yyyy-MM'\n)",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Setting startDate for Copy Data",
        "dependsOn": [
          {
            "activity": "Latest processed data",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
    "variables": {
      "v_date": {
        "type": "String",
        "defaultValue": "2024-01"
      },
      "v_end_date": {
        "type": "String"
      }
    }
